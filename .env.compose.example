# ─────────────────────────────────────────────────────────────────────────────
# DailyByte News — Docker Compose Environment Template
#
# Hướng dẫn:
#   1. Copy file này thành `.env` nằm cùng thư mục với `docker-compose.yml`:
#      cp .env.compose.example .env
#   2. Điền các giá trị API keys và secrets cần thiết bên dưới.
#   3. Khởi động hệ thống: docker compose up --build
# ─────────────────────────────────────────────────────────────────────────────

# ─── API URL CỦA BACKEND (DÙNG CHO NEXT.JS) ──────────────────────────────────
# Địa chỉ backend phục vụ cho frontend Next.js.
# Khi chạy local với Docker Compose, mặc định là http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── PRIMARY LLM & TTS (OPENAI / COMPATIBLE API) ────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.pinkyne.com/v1
OPENAI_MODEL=gpt-5.1
OPENAI_COMPOSITION_MODEL=claude-sonnet-4-6
OPENAI_TTS_MODEL=speech-2.8-hd
OPENAI_TTS_VOICE=female-tianmei

# ─── OCR CONFIGURATION ───────────────────────────────────────────────────────
# Giới hạn số trang PDF tối đa được xử lý qua OCR (Tránh quá tải và tối ưu chi phí)
MAX_OCR_PAGES=100
# Kích thước lô (batch size) gửi song song lên LLM API để OCR (Tránh timeout & payload size limit)
OCR_BATCH_SIZE=5

# ─── FALLBACK LLM (ANTHROPIC / COMPATIBLE API) ──────────────────────────────
# Tự động chuyển đổi dự phòng khi API chính hết hạn mức hoặc lỗi.
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://api.anthropic.com/v1/
FALLBACK_MODEL=claude-sonnet-4-6

# ─── GROQ API (TỐC ĐỘ CAO, FREE TIER) ────────────────────────────────────────
# Tùy chọn fallback cuối cùng cho phần sinh nội dung/layout HTML.
GROQ_API_KEY=

# ─── SUPABASE CONFIGURATION (AUTHENTICATION & DATA STORAGE) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ─── NEXTAUTH (CẤU HÌNH ĐĂNG NHẬP) ──────────────────────────────────────────
# URL của Frontend. Khi chạy Docker Compose local mặc định là: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Key bảo mật để mã hóa sessions NextAuth. Tạo chuỗi ngẫu nhiên dài hơn 32 ký tự.
# Bạn có thể sinh key nhanh bằng lệnh: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-at-least-32-character-long-string-for-security

# ─── GOOGLE OAUTH (ĐĂNG NHẬP BẰNG GOOGLE) ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
