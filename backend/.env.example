OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.pinkyne.com/v1
OPENAI_MODEL=gpt-5.1
OPENAI_SCENES_MODEL=gpt-5.1
OPENAI_COMPOSITION_MODEL=claude-sonnet-4-6
OPENAI_TTS_MODEL=speech-2.8-hd
OPENAI_TTS_VOICE=female-tianmei
HYPERFRAMES_PROJECT=D:\AI_Video_Edit\my-video

# ─── Fallback LLM (used automatically when primary returns quota / 402) ───
# Default fallback hits Anthropic direct via their OpenAI-compatible endpoint.
# Get an Anthropic key: https://console.anthropic.com/settings/keys
# Either FALLBACK_API_KEY or ANTHROPIC_API_KEY works (FALLBACK_API_KEY wins).
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://api.anthropic.com/v1/
FALLBACK_MODEL=claude-sonnet-4-6
# Optional per-task overrides — uncomment to fine-tune
# FALLBACK_SCENES_MODEL=claude-sonnet-4-6
# FALLBACK_COMPOSITION_MODEL=claude-sonnet-4-6
# FALLBACK_OCR_MODEL=claude-sonnet-4-6

# ─── Groq (free tier, very fast) — last in fallback chain ─────────────────
# Get a Groq key: https://console.groq.com/keys
# Free tier covers most personal projects. Llama 3.3 70B handles HTML well.
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile          (primary groq model)
# GROQ_FAST_MODEL=meta-llama/llama-4-scout-17b-16e-instruct  (fallback when 70B hits TPD; TPM 30K, TPD 500K)
# GROQ_SCENES_MODEL=llama-3.3-70b-versatile
# GROQ_COMPOSITION_MODEL=llama-3.3-70b-versatile
# GROQ_MAX_SCENES=5                           (merge scenes when using groq)

# ElevenLabs TTS (primary; falls back to gTTS if not set or fails)
# Get key: https://elevenlabs.io/app/settings/api-keys
# IMPORTANT: paste your real key in .env, NOT this file (.env.example is committed to git)
ELEVENLABS_API_KEY=
# Default voice "Adam" (multilingual, good with Vietnamese). Browse: https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

